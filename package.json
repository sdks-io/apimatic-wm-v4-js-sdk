{
  "name": "apimatic-wm-v4-sdk",
  "version": "4.0.0",
  "description": "This is a sample SDK generated by APIMatic",
  "keywords": [
    "apimatic",
    "sdksio"
  ],
  "homepage": "https://apimatic.io",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "tshy": {
    "exports": {
      ".": "./src/index.ts",
      "./package.json": "./package.json"
    },
    "dialects": [
      "esm",
      "commonjs"
    ],
    "project": "./tsconfig.tshy.json",
    "selfLink": false
  },
  "main": "./dist/commonjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "tsconfig.tshy.json",
    "README.md",
    "api-reference.md",
    "sdk-map.md",
    "map"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "prepare": "tshy",
    "build": "tshy",
    "smoke": "node -e \"require('apimatic-wm-v4-sdk')\" && node --input-type=module -e \"import('apimatic-wm-v4-sdk')\"",
    "typecheck": "tsc --noEmit",
    "typecheck:dom": "tsc --noEmit -p tsconfig.dom.json",
    "lint": "oxlint --type-aware --max-warnings=0 src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src"
  },
  "license": "MIT",
  "author": {
    "name": "developer sdksio",
    "email": "developer+sdksio@apimatic.io"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sdks-io/apimatic-wm-v4-js-sdk.git"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tshy": "^4.1.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "zod": "^4.1.0"
  }
}
